// PostgreSQL (Vercel 배포용: Neon 무료 DB 권장)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  adultOnly Boolean   @default(false) // 성인 카테고리: 인증 전에는 목록·이름·이미지 숨김
  sort      Int       @default(0)
  products  Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  price       Int
  salePrice   Int?
  description String      @default("")
  imageUrl    String?
  stock       Int         @default(0)
  options     String      @default("") // 쉼표 구분 옵션 (예: "S,M,L")
  active      Boolean     @default(true)
  adultOnly   Boolean     @default(false)
  // ── 스타일 맞춤용 태그 (lib/style.ts 의 키 사용) ──
  gender      String      @default("U") // M 남성, F 여성, U 공용
  styles      String      @default("")  // 쉼표 구분 (예: "minimal,dandy")
  fit         String      @default("")  // slim / regular / over
  colors      String      @default("")  // 쉼표 구분 (예: "블랙,네이비")
  sizeChart   String      @default("")  // 실측표 CSV (첫 줄 머리글)
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
  lookItems   LookItem[]
}

// 코디(룩): 여러 상품을 한 세트로 제안
model Look {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  description String     @default("")
  imageUrl    String?
  gender      String     @default("U")
  styles      String     @default("")
  active      Boolean    @default(true)
  sort        Int        @default(0)
  createdAt   DateTime   @default(now())
  items       LookItem[]
}

model LookItem {
  id        Int     @id @default(autoincrement())
  lookId    Int
  look      Look    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sort      Int     @default(0)
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNo     String      @unique
  // PENDING(결제대기) PAID(결제완료) SHIPPING(배송중) DELIVERED(배송완료) CANCELED(취소)
  status      String      @default("PENDING")
  buyerName   String
  buyerPhone  String
  buyerEmail  String
  recipient   String
  phone       String
  zipcode     String
  address1    String
  address2    String      @default("")
  memo        String      @default("")
  itemsTotal  Int
  shippingFee Int
  total       Int
  orderName   String
  hasAdult    Boolean     @default(false)
  paymentKey  String?
  paidAt      DateTime?
  trackingNo  String?
  createdAt   DateTime    @default(now())
  items       OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String
  option    String  @default("")
  price     Int
  quantity  Int
}

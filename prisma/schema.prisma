// PostgreSQL (Vercel 배포용: Neon 무료 DB 권장)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  menuName  String    @default("") // 상단 메뉴용 짧은 이름 (비우면 name 사용)
  slug      String    @unique
  adultOnly Boolean   @default(false) // 성인 카테고리: 인증 전에는 목록·이름·이미지 숨김
  sort      Int       @default(0)
  products  Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  price       Int
  salePrice   Int?
  description String      @default("")
  imageUrl    String?
  stock       Int         @default(0)
  options     String      @default("") // 쉼표 구분 옵션 (예: "S,M,L")
  active      Boolean     @default(true)
  adultOnly   Boolean     @default(false)
  // ── 스타일 맞춤용 태그 (lib/style.ts 의 키 사용) ──
  line        String      @default("")  // 브랜드 라인: formal / smart / lounge (lib/lines.ts)
  gender      String      @default("U") // M 남성, F 여성, U 공용
  styles      String      @default("")  // 쉼표 구분 (예: "minimal,dandy")
  fit         String      @default("")  // slim / regular / over
  colors      String      @default("")  // 쉼표 구분 (예: "블랙,네이비")
  sizeChart   String      @default("")  // 실측표 CSV (첫 줄 머리글)
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
  lookItems   LookItem[]
}

// 코디(룩): 여러 상품을 한 세트로 제안
model Look {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  description String     @default("")
  imageUrl    String?
  gender      String     @default("U")
  styles      String     @default("")
  active      Boolean    @default(true)
  sort        Int        @default(0)
  createdAt   DateTime   @default(now())
  items       LookItem[]
}

model LookItem {
  id        Int     @id @default(autoincrement())
  lookId    Int
  look      Look    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sort      Int     @default(0)
}

// 관리자가 업로드한 이미지 (별도 저장소 없이 DB에 보관, /img/{id} 로 제공)
// id는 추측 불가능한 랜덤 값이라 성인 상품 이미지 주소를 짐작해서 열 수 없음
model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  size      Int
  width     Int      @default(0)
  height    Int      @default(0)
  createdAt DateTime @default(now())
}

// 회원 (카카오·네이버 로그인). 비회원 주문도 계속 가능
model User {
  id          Int      @id @default(autoincrement())
  provider    String   // kakao / naver / demo
  providerId  String
  name        String   @default("")
  email       String   @default("")
  phone       String   @default("")
  styleProfile String  @default("") // 스타일 진단 결과(JSON). 비어 있으면 로그인 직후 진단으로 안내
  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())
  orders      Order[]

  @@unique([provider, providerId])
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNo     String      @unique
  userId      Int?        // 회원 주문이면 연결 (탈퇴 시 연결만 끊고 주문 기록은 보관)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // PENDING(결제대기) PAID(결제완료) SHIPPING(배송중) DELIVERED(배송완료) CANCELED(취소)
  status      String      @default("PENDING")
  buyerName   String
  buyerPhone  String
  buyerEmail  String
  recipient   String
  phone       String
  zipcode     String
  address1    String
  address2    String      @default("")
  memo        String      @default("")
  itemsTotal  Int
  shippingFee Int
  total       Int
  orderName   String
  hasAdult    Boolean     @default(false)
  paymentKey  String?
  paidAt      DateTime?
  trackingNo  String?
  createdAt   DateTime    @default(now())
  items       OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String
  option    String  @default("")
  price     Int
  quantity  Int
}

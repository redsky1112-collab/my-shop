// PostgreSQL (Vercel 배포용: Neon 무료 DB 권장)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  menuName  String    @default("") // 상단 메뉴용 짧은 이름 (비우면 name 사용)
  slug      String    @unique
  adultOnly Boolean   @default(false) // 성인 카테고리: 인증 전에는 목록·이름·이미지 숨김
  sort      Int       @default(0)
  products  Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  price       Int
  salePrice   Int?
  description String      @default("")
  imageUrl    String?     // 대표 사진 (= images 첫 장, 목록·장바구니용)
  images      String[]    @default([]) // 상품 사진 여러 장 (순서대로, 첫 장이 대표)
  garmentImage String     @default("")  // 가상 피팅용 '옷만 찍힌' 사진 (비우면 첫 사진 사용)
  stock       Int         @default(0)
  options     String      @default("") // 쉼표 구분 옵션 (예: "S,M,L")
  active      Boolean     @default(true)
  adultOnly   Boolean     @default(false)
  // ── 스타일 맞춤용 태그 (lib/style.ts 의 키 사용) ──
  line        String      @default("")  // 브랜드 라인: formal / smart / lounge (lib/lines.ts)
  gender      String      @default("U") // M 남성, F 여성, U 공용
  styles      String      @default("")  // 쉼표 구분 (예: "minimal,dandy")
  fit         String      @default("")  // slim / regular / over
  colors      String      @default("")  // 쉼표 구분 (예: "블랙,네이비")
  sizeChart   String      @default("")  // 실측표 CSV (첫 줄 머리글)
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
  lookItems   LookItem[]
  variants    Variant[]
  reviews     Review[]
  wishes      Wish[]
  restockAlerts RestockAlert[]
}

// 옵션(사이즈)별 재고. Product.stock 은 이 합계로 자동 맞춰짐
model Variant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  option    String
  stock     Int     @default(0)
  sort      Int     @default(0)

  @@unique([productId, option])
}

// 코디(룩): 여러 상품을 한 세트로 제안
model Look {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  description String     @default("")
  imageUrl    String?
  line        String     @default("") // 브랜드 라인 (formal/smart/lounge)
  gender      String     @default("U")
  styles      String     @default("")
  active      Boolean    @default(true)
  sort        Int        @default(0)
  createdAt   DateTime   @default(now())
  items       LookItem[]
}

model LookItem {
  id        Int     @id @default(autoincrement())
  lookId    Int
  look      Look    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sort      Int     @default(0)
}

// 첫 화면 메인 배너 (모델 사진 슬라이드)
model Banner {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  tagline   String   @default("") // 작은 영문 문구 (예: CONTEMPORARY LOOK FOR 3040)
  title     String   @default("") // 큰 제목
  sub       String   @default("") // 한 줄 설명
  link      String   @default("") // 누르면 이동할 주소 (예: /category/outer)
  full      Boolean  @default(false) // 글자가 들어간 완성 이미지: 자르지 않고 통째로 보여주고 문구를 덧씌우지 않음
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 관리자가 업로드한 이미지 (별도 저장소 없이 DB에 보관, /img/{id} 로 제공)
// id는 추측 불가능한 랜덤 값이라 성인 상품 이미지 주소를 짐작해서 열 수 없음
model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  size      Int
  width     Int      @default(0)
  height    Int      @default(0)
  createdAt DateTime @default(now())
}

// 회원 (카카오·네이버 로그인). 비회원 주문도 계속 가능
model User {
  id          Int      @id @default(autoincrement())
  provider    String   // kakao / naver / demo
  providerId  String
  name        String   @default("")
  email       String   @default("")
  phone       String   @default("")
  styleProfile String  @default("") // 스타일 진단 결과(JSON). 비어 있으면 로그인 직후 진단으로 안내
  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())
  orders      Order[]
  reviews     Review[]
  wishes      Wish[]
  restockAlerts RestockAlert[]

  @@unique([provider, providerId])
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNo     String      @unique
  userId      Int?        // 회원 주문이면 연결 (탈퇴 시 연결만 끊고 주문 기록은 보관)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // PENDING(결제대기) PAID(결제완료) SHIPPING(배송중) DELIVERED(배송완료) CANCELED(취소)
  status      String      @default("PENDING")
  buyerName   String
  buyerPhone  String
  buyerEmail  String
  recipient   String
  phone       String
  zipcode     String
  address1    String
  address2    String      @default("")
  memo        String      @default("")
  itemsTotal  Int
  shippingFee Int
  total       Int
  orderName   String
  hasAdult    Boolean     @default(false)
  giftWrap    Boolean     @default(false) // 선물 포장 선택
  giftFee     Int         @default(0)     // 선물 포장비 (total에 포함)
  giftMessage String      @default("")    // 메시지 카드 문구
  discount    Int         @default(0)     // 쿠폰 할인액 (total에서 이미 뺀 금액)
  couponName  String      @default("")    // 적용한 쿠폰 이름 (예: 첫 구매 10% 할인)
  paymentKey  String?
  paidAt      DateTime?
  trackingNo  String?
  courier     String      @default("") // 택배사 코드 (lib/couriers.ts, 비우면 기본 택배사)
  refundedAmount   Int       @default(0)     // 지금까지 환불한 금액 합계
  shippingRefunded Boolean   @default(false) // 배송비를 이미 환불했는지
  canceledAt       DateTime?
  deliveredAt      DateTime? // 배송완료 처리 시각 (교환·반품 신청 기한 기준)
  createdAt   DateTime    @default(now())
  items       OrderItem[]
  refunds     Refund[]
  claims      Claim[]
}

// 교환·반품 신청
model Claim {
  id               Int      @id @default(autoincrement())
  orderId          Int
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type             String   // RETURN(반품) / EXCHANGE(교환)
  status           String   @default("REQUESTED") // REQUESTED APPROVED COLLECTING COMPLETED REJECTED
  reason           String
  sellerFault      Boolean  @default(false) // 불량·오배송 등 판매자 책임 (배송비 판매자 부담)
  detail           String   @default("")
  photos           String   @default("") // 쉼표 구분 이미지 주소
  items            String   // JSON [{itemId, qty, toOption}]
  returnTrackingNo String   @default("") // 회수 송장
  resendTrackingNo String   @default("") // 교환 상품 발송 송장
  adminMemo        String   @default("") // 고객에게 보이는 안내 문구
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 결제 취소·환불 기록 (부분 취소 포함)
model Refund {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Int
  reason     String
  detail     String   @default("") // 취소한 상품 요약 (예: "울 코트(M) ×1")
  restocked  Boolean  @default(true)
  by         String   @default("admin") // admin / customer
  createdAt  DateTime @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String
  option    String  @default("")
  price     Int
  quantity  Int
  canceledQty Int   @default(0) // 취소·환불된 수량
  review    Review?
}

// 구매 후기 (배송완료된 회원 주문 상품 1건당 1개). 체형은 작성 시점 값을 복사해 둠 → "나와 비슷한 체형" 필터
model Review {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId Int       @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String    @default("") // 가린 이름 (예: 김*수)
  rating      Int       // 1~5
  sizeFeel    String    @default("") // small 작아요 / fit 정사이즈 / big 커요
  content     String
  option      String    @default("") // 구매한 옵션(사이즈)
  photos      String[]  @default([])
  // ── 작성 시점 체형 (0·빈칸 = 안 알려줌) ──
  gender      String    @default("") // M / F
  height      Int       @default(0)
  weight      Int       @default(0)
  bodyType    String    @default("") // lib/style.ts BODY_TYPES
  hidden      Boolean   @default(false) // 관리자 숨김
  createdAt   DateTime  @default(now())

  @@index([productId, hidden])
}

// 찜 (회원). 비회원은 브라우저에 저장했다가 로그인하면 여기로 합쳐짐
model Wish {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// 재입고 알림 신청. 품절 옵션(사이즈)에 신청 → 재고가 다시 생기면 관리자 '재입고 알림'에 발송 대상으로 뜸
model RestockAlert {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  option     String    @default("") // 빈칸 = 옵션 없는 상품
  phone      String    // 숫자만 (문자·알림톡 발송용)
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  notifiedAt DateTime? // 알림 보낸 시각 (비어 있으면 대기)
  createdAt  DateTime  @default(now())

  @@unique([productId, option, phone])
  @@index([notifiedAt])
}

// 간단한 설정 저장 (예: ai_face_ref = 브랜드 AI 모델 얼굴 사진 주소)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// FASHN AI 작업 기록. kind: photo(관리자 AI 화보) / fitting(고객 가상 피팅)
// 고객 사진은 저장하지 않음 — 생성 요청에만 쓰고 버림
model AiJob {
  id           Int      @id @default(autoincrement())
  kind         String
  userId       Int?     // fitting: 요청한 회원
  productId    Int
  predictionId String   @unique
  status       String   @default("processing") // processing / completed / failed
  outputs      String[] @default([]) // FASHN 결과 주소 (3일 후 만료)
  error        String   @default("")
  credits      Int      @default(0) // 예상 사용 크레딧
  createdAt    DateTime @default(now())

  @@index([kind, userId, createdAt])
}

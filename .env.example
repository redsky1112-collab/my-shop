# ── 기본 ──
# Neon(neon.tech) 등 PostgreSQL 접속 주소
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# 아무 긴 랜덤 문자열 (32자 이상 권장). 쿠키 서명에 사용
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# 관리자 페이지 비밀번호
ADMIN_PASSWORD="admin1234"
# 사이트 주소 (배포 시 실제 도메인으로)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── 토스페이먼츠 (결제위젯) ──
# 아래는 토스페이먼츠 개발자문서에 공개된 테스트 키입니다. 실제 결제가 일어나지 않아요.
# 가입 후 개발자센터 > API 키 메뉴의 "결제위젯 연동 키"로 교체하세요.
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm"
TOSS_SECRET_KEY="test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6"

# ── 성인인증 ──
# mock  : 개발용(버튼 한 번으로 통과). 운영(NODE_ENV=production)에서는 자동 차단됩니다.
# portone: 포트원 V2 본인인증 (PASS/휴대폰). 아래 3개 값 필요
ADULT_VERIFY_MODE="mock"
NEXT_PUBLIC_PORTONE_STORE_ID=""
NEXT_PUBLIC_PORTONE_IDV_CHANNEL_KEY=""
PORTONE_API_SECRET=""

# 배포 사이트에서 개발용 성인인증 버튼을 쓰려면 아래 값 지정. ⚠️ 실제 오픈 전 반드시 삭제
# ADULT_MOCK_ALLOW_PROD="yes-test-only"
